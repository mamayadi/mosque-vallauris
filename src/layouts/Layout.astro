---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'La grande Mosquée de Vallauris',
  description = 'Site officiel de la grande Mosquée de Vallauris — Horaires de prières, localisation et dons.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage     = new URL('/favicon.svg', Astro.site).href;

// BASE_URL may or may not have a trailing slash depending on Astro version
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PlaceOfWorship',
  name: 'Grande Mosquée de Vallauris',
  alternateName: 'Association Culturelle de Vallauris',
  description,
  url: 'https://mosquee-vallauris.fr',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '11bis Boulevard des Deux Vallons',
    addressLocality: 'Vallauris',
    postalCode: '06220',
    addressRegion: 'Provence-Alpes-Côte d\'Azur',
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 43.577944,
    longitude: 7.052169,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  sameAs: [
    'https://mawaqit.net/fr/m/mosquee-de-vallauris-vallauris-06220-france',
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a472a" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:locale"      content="fr_FR" />
    <meta property="og:site_name"   content="Mosquée de Vallauris" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml"           href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180"    href={`${base}/apple-touch-icon.png`} />

    <title>{title}</title>

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-beige-100 text-green-800 antialiased">
    <slot />
  </body>
</html>
