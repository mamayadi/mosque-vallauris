---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'La grande Mosquée de Vallauris',
  description = 'Site officiel de la grande Mosquée de Vallauris — Horaires de prières, localisation et dons.',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a472a" />
    <link rel="icon" type="image/svg+xml"  href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32.png`} />
    <link rel="apple-touch-icon" sizes="180x180"    href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <title>{title}</title>
  </head>
  <body class="bg-beige-100 text-green-800 antialiased">
    <slot />
  </body>
</html>
