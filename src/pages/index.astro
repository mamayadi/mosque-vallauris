---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import logoSvg from '../assets/logo.svg?raw';
import mosqueSvg from '../assets/mosque-illustration.svg?raw';

const mawaqitUrl    = 'https://mawaqit.net/fr/m/mosquee-de-vallauris-vallauris-06220-france';
const helloAssoUrl  = 'https://www.helloasso.com/associations/association-culturelle-de-vallauris/formulaires/1';
const googleMapsUrl = 'https://maps.app.goo.gl/iCYVHbP1aZfZmQH88';
const address       = '11bis Bd des Deux Vallons, 06220 Vallauris';

const services = [
  { label: 'Espace pour femmes',  available: true,  icon: 'ph:gender-female'   },
  { label: "Salle d'ablutions",   available: true,  icon: 'ph:drop'            },
  { label: 'Cours pour adultes',  available: true,  icon: 'ph:books'           },
  { label: 'Cours pour enfants',  available: true,  icon: 'ph:graduation-cap'  },
  { label: 'Accès handicapés',    available: false, icon: 'ph:wheelchair'      },
  { label: 'Salât al-Janaza',     available: false, icon: 'ph:mosque'          },
  { label: "Salat Al-Aïd",        available: true,  icon: 'ph:moon-stars'      },
  { label: 'Iftar Ramadan',       available: true,  icon: 'ph:moon-stars'      },
  { label: 'Parking',             available: false, icon: 'ph:car'             },
];

const activities = [
  { icon: 'ph:mosque',         label: 'Cinq prières quotidiennes',                ar: 'الصلوات الخمس'       },
  { icon: 'ph:sun',            label: "Prière du vendredi (Jumu'ah)",              ar: 'صلاة الجمعة'          },
  { icon: 'ph:graduation-cap', label: "Cours de Coran et d'arabe — enfants",      ar: 'تعليم القرآن والعربية' },
  { icon: 'ph:books',          label: 'Cours islamiques pour adultes',             ar: 'دروس إسلامية للكبار'  },
  { icon: 'ph:gender-female',  label: 'Espace de prière pour femmes',             ar: 'قسم النساء'           },
  { icon: 'ph:moon-stars',     label: 'Iftar et Tarawih — Ramadan',               ar: 'إفطار رمضان'          },
  { icon: 'ph:moon-stars',     label: "Prière de l'Aïd al-Fitr et al-Adha",      ar: 'صلاة العيد'           },
];

const faqItems = [
  {
    q: "Où se trouve la Grande Mosquée de Vallauris ?",
    a: "La Grande Mosquée de Vallauris est située au 11bis Boulevard des Deux Vallons, 06220 Vallauris, Alpes-Maritimes. Elle est accessible depuis Golfe-Juan, Antibes et Cannes.",
  },
  {
    q: "Quels sont les horaires de prière à la mosquée de Vallauris ?",
    a: "Les horaires des cinq prières quotidiennes — Fajr (الفجر), Dhuhr (الظهر), Asr (العصر), Maghrib (المغرب) et Isha (العشاء) — varient chaque jour. Consultez Mawaqit pour les horaires en temps réel.",
  },
  {
    q: "Y a-t-il une prière du vendredi (Jumu'ah) à Vallauris ?",
    a: "Oui, la prière du vendredi (صلاة الجمعة) est célébrée chaque semaine à la mosquée de Vallauris. L'heure exacte varie selon la saison et est disponible sur Mawaqit.",
  },
  {
    q: "La mosquée dispose-t-elle d'un espace pour les femmes ?",
    a: "Oui, la mosquée de Vallauris dispose d'un espace dédié aux femmes pour la prière.",
  },
  {
    q: "Y a-t-il des cours d'arabe ou de Coran à Vallauris ?",
    a: "Oui, la mosquée propose des cours d'arabe et d'éducation islamique pour les enfants et les adultes. Contactez l'association pour les détails et les inscriptions.",
  },
  {
    q: "Comment soutenir financièrement la mosquée de Vallauris ?",
    a: "Vous pouvez faire un don en ligne via HelloAsso, la plateforme sécurisée de l'Association Culturelle de Vallauris. Chaque contribution aide à l'entretien du lieu et aux activités communautaires.",
  },
  {
    q: "La mosquée est-elle ouverte pendant le Ramadan ?",
    a: "Oui, la mosquée est particulièrement active pendant le mois de Ramadan : iftars communautaires, prières de Tarawih et prière de l'Aïd al-Fitr sont organisés chaque année.",
  },
  {
    q: "Comment rejoindre l'association ou obtenir plus d'informations ?",
    a: "Vous pouvez contacter l'Association Culturelle de Vallauris directement ou via HelloAsso. Retrouvez aussi les horaires en temps réel sur Mawaqit.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout
  title="Grande Mosquée de Vallauris — Horaires Prières, Cours, Dons | 06220"
  description="Grande Mosquée de Vallauris (06220, Alpes-Maritimes) — Horaires des 5 prières quotidiennes, Jumu'ah du vendredi, cours d'arabe et de Coran, espace femmes. Association Culturelle de Vallauris."
  additionalSchema={faqSchema}
>
  <!-- ══════════════════════════════════════════
       NAVIGATION
  ══════════════════════════════════════════ -->
  <nav id="navbar"
       class="fixed top-0 left-0 right-0 z-50 transition-all duration-300
              bg-green-800/95 backdrop-blur-sm shadow-lg"
  >
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <!-- Logo -->
      <a href="#accueil" class="flex items-center gap-2 text-beige-100 hover:text-gold transition-colors">
        <Fragment set:html={logoSvg} />
        <span class="font-amiri text-sm font-bold hidden sm:inline leading-tight">
          Grande Mosquée<br/><span class="text-gold">de Vallauris</span>
        </span>
      </a>

      <!-- Links -->
      <ul class="flex items-center gap-1 sm:gap-3 text-beige-200 text-sm font-semibold">
        <li>
          <a href="#apropos"
             class="flex items-center gap-1.5 px-2 sm:px-3 py-2 rounded-lg hover:bg-white/10 hover:text-gold transition-all">
            <Icon name="ph:info" class="w-4 h-4" />
            <span class="hidden sm:inline">À propos</span>
          </a>
        </li>
        <li>
          <a href="#prieres"
             class="flex items-center gap-1.5 px-2 sm:px-3 py-2 rounded-lg hover:bg-white/10 hover:text-gold transition-all">
            <Icon name="ph:mosque" class="w-4 h-4" />
            Prières
          </a>
        </li>
        <li>
          <a href="#localisation"
             class="flex items-center gap-1.5 px-2 sm:px-3 py-2 rounded-lg hover:bg-white/10 hover:text-gold transition-all">
            <Icon name="ph:map-pin" class="w-4 h-4" />
            <span class="hidden sm:inline">Plan</span>
          </a>
        </li>
        <li>
          <a href={helloAssoUrl} target="_blank" rel="noopener"
             class="flex items-center gap-1.5 px-3 py-2 rounded-full bg-gold text-green-800 hover:bg-gold-light transition-all font-bold">
            <Icon name="ph:hand-heart" class="w-4 h-4" />
            Don
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section id="accueil"
           class="relative min-h-screen flex flex-col items-center justify-center text-center
                  bg-pattern-dark overflow-hidden pt-16">

    <div class="absolute inset-0 bg-radial-glow pointer-events-none"></div>
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>

    <!-- Mosque SVG illustration -->
    <div class="relative z-10 w-full max-w-lg mx-auto px-4 mb-6 text-beige-100 opacity-90">
      <Fragment set:html={mosqueSvg} />
    </div>

    <!-- Title -->
    <div class="relative z-10 px-4 animate-fade-in">
      <div class="divider-gold max-w-xs mx-auto mb-4">
        <span class="text-gold text-xl">بسم الله الرحمن الرحيم</span>
      </div>
      <h1 class="font-amiri text-4xl sm:text-5xl md:text-6xl font-bold text-beige-100 leading-tight">
        La grande Mosquée<br/>
        <span class="text-gold">de Vallauris</span>
      </h1>
      <p class="mt-4 text-beige-300 text-lg sm:text-xl font-light max-w-xl mx-auto">
        Bienvenue dans votre mosquée — un lieu de prière, de paix et de fraternité
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={helloAssoUrl} target="_blank" rel="noopener" class="btn-gold">
          <Icon name="ph:hand-heart" class="w-5 h-5" />
          Faire un don
        </a>
        <a href="#prieres" class="btn-outline">
          <Icon name="ph:mosque" class="w-6 h-6" />
          Horaires des prières
        </a>
      </div>
    </div>

    <!-- Scroll hint -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-gold/60 animate-bounce z-10">
      <Icon name="ph:caret-circle-down" class="w-8 h-8" />
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       À PROPOS
  ══════════════════════════════════════════ -->
  <section id="apropos" class="py-20 bg-pattern-beige">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="heading-ornament text-4xl sm:text-5xl text-green-800 mb-2">
        À propos de notre Mosquée
      </h2>
      <p class="text-center font-amiri text-2xl text-green-700/60 mb-12">عن مسجدنا</p>

      <div class="grid md:grid-cols-2 gap-10 items-start">

        <!-- Description text -->
        <div class="space-y-4 text-green-800 text-base leading-relaxed">
          <p>
            La <strong>Grande Mosquée de Vallauris</strong> est le principal lieu de culte islamique
            de la ville de <strong>Vallauris (06220)</strong>, dans les Alpes-Maritimes.
            Gérée par l'<strong>Association Culturelle de Vallauris</strong>, elle accueille
            la communauté musulmane de Vallauris, Golfe-Juan et des communes voisines de la Côte d'Azur.
          </p>
          <p>
            Ouverte chaque jour pour les <strong>cinq prières quotidiennes</strong> —
            <span lang="ar">الفجر</span> Fajr,
            <span lang="ar">الظهر</span> Dhuhr,
            <span lang="ar">العصر</span> Asr,
            <span lang="ar">المغرب</span> Maghrib et
            <span lang="ar">العشاء</span> Isha —
            la mosquée est aussi un espace d'apprentissage, de rencontre et de solidarité.
          </p>
          <p>
            La <strong>prière du vendredi</strong>
            (<span lang="ar" class="font-amiri">صلاة الجمعة</span> — Jumu'ah)
            rassemble chaque semaine les fidèles de Vallauris et des environs pour un moment de
            recueillement et d'écoute.
          </p>

          <!-- Quranic verse -->
          <blockquote class="mt-6 border-l-4 border-gold pl-4 space-y-2">
            <p class="font-amiri text-xl text-green-800 leading-relaxed" lang="ar" dir="rtl">
              ﴿ إِنَّمَا يَعْمُرُ مَسَاجِدَ اللَّهِ مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ ﴾
            </p>
            <footer class="text-sm text-green-600 italic">
              « Les mosquées d'Allah ne sont fréquentées que par ceux qui croient en Allah
              et au Jour Dernier. » — Sourate At-Tawbah, 18
            </footer>
          </blockquote>
        </div>

        <!-- Activities list -->
        <div>
          <h3 class="font-amiri text-2xl text-green-800 mb-5 flex items-center gap-2">
            <Icon name="ph:star-four" class="w-5 h-5 text-gold" />
            Activités &amp; services
            <span class="font-amiri text-lg text-green-600/60 mr-2" lang="ar">— الخدمات</span>
          </h3>
          <ul class="space-y-2">
            {activities.map(({ icon, label, ar }) => (
              <li class="flex items-center gap-3 px-4 py-3 rounded-lg bg-white border border-green-100 shadow-sm">
                <Icon name={icon} class="w-5 h-5 text-gold shrink-0" />
                <span class="flex-1 text-sm font-medium text-green-800">{label}</span>
                <span class="font-amiri text-sm text-green-500 shrink-0" lang="ar">{ar}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       HORAIRES DES PRIÈRES
  ══════════════════════════════════════════ -->
  <section id="prieres" class="py-20 bg-pattern-dark">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="heading-ornament text-4xl sm:text-5xl text-beige-100 mb-2">
        Horaires des Prières
      </h2>
      <p class="text-center font-amiri text-2xl text-beige-400/70 mb-3" lang="ar">مواقيت الصلاة</p>
      <p class="text-center text-beige-300 mb-10 text-lg">
        Cinq prières quotidiennes — en direct depuis
        <a href={mawaqitUrl} target="_blank" rel="noopener"
           class="text-gold font-semibold underline underline-offset-2 hover:text-gold-light transition-colors">
          Mawaqit
        </a>
      </p>

      <div class="card-arabesque bg-white shadow-xl overflow-hidden">
        <div class="relative w-full" style="padding-top: 65%;">
          <iframe
            src={mawaqitUrl}
            class="absolute inset-0 w-full h-full border-0"
            loading="lazy"
            title="Horaires des prières — Mosquée de Vallauris sur Mawaqit"
            sandbox="allow-scripts allow-same-origin"
          ></iframe>
        </div>
      </div>

      <div class="mt-6 text-center">
        <a href={mawaqitUrl} target="_blank" rel="noopener"
           class="btn-outline text-beige-200 border-beige-400 inline-flex items-center gap-2">
          Voir les horaires sur Mawaqit
          <Icon name="ph:arrow-square-out" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       INFOS PRATIQUES
  ══════════════════════════════════════════ -->
  <section class="py-20 bg-pattern-beige">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="heading-ornament text-4xl sm:text-5xl text-green-800 mb-10">
        Informations pratiques
      </h2>

      <div class="grid sm:grid-cols-2 gap-8">
        <!-- Adresse -->
        <div class="card-arabesque bg-white border border-green-100 p-6 text-green-800">
          <h3 class="font-amiri text-2xl text-gold mb-4 flex items-center gap-2">
            <Icon name="ph:map-pin-fill" class="w-6 h-6" />
            Adresse
          </h3>
          <p class="text-lg leading-relaxed font-medium">{address}</p>
          <p class="mt-1 text-green-600">Vallauris, Alpes-Maritimes (06)</p>
          <a href={googleMapsUrl} target="_blank" rel="noopener"
             class="mt-4 inline-flex items-center gap-2 text-gold hover:text-gold-light underline text-sm">
            Ouvrir dans Google Maps
            <Icon name="ph:arrow-square-out" class="w-3.5 h-3.5" />
          </a>
        </div>

        <!-- Accès -->
        <div class="card-arabesque bg-white border border-green-100 p-6 text-green-800">
          <h3 class="font-amiri text-2xl text-gold mb-4 flex items-center gap-2">
            <Icon name="ph:clock-fill" class="w-6 h-6" />
            Accès
          </h3>
          <ul class="space-y-3 text-base leading-relaxed">
            <li class="flex items-start gap-2">
              <Icon name="ph:check-circle" class="w-5 h-5 text-gold shrink-0 mt-0.5" />
              Ouverte tous les jours pour les cinq prières
            </li>
            <li class="flex items-start gap-2">
              <Icon name="ph:check-circle" class="w-5 h-5 text-gold shrink-0 mt-0.5" />
              Prière du vendredi (Jumu'ah) — suivez les horaires sur Mawaqit
            </li>
            <li class="flex items-start gap-2">
              <Icon name="ph:check-circle" class="w-5 h-5 text-gold shrink-0 mt-0.5" />
              Ablutions disponibles sur place
            </li>
          </ul>
        </div>
      </div>

      <!-- Installations & services -->
      <div class="mt-10">
        <h3 class="heading-ornament font-amiri text-2xl text-green-800 mb-6">
          Installations &amp; services
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          {services.map(({ label, available, icon }) => (
            <div class={`card-arabesque flex items-center gap-3 px-4 py-3 ${available ? 'bg-green-50 border border-green-100' : 'bg-gray-50 border border-gray-100'}`}>
              <Icon name={icon} class={`w-5 h-5 shrink-0 ${available ? 'text-gold' : 'text-gray-400'}`} />
              <span class={`text-sm font-medium leading-tight ${available ? 'text-green-800' : 'text-gray-400'}`}>
                {label}
              </span>
              <span class="ml-auto shrink-0">
                {available
                  ? <Icon name="ph:check-circle-fill" class="w-4 h-4 text-gold" />
                  : <Icon name="ph:x-circle"          class="w-4 h-4 text-gray-300" />
                }
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       LOCALISATION
  ══════════════════════════════════════════ -->
  <section id="localisation" class="py-20 bg-pattern-dark">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="heading-ornament text-4xl sm:text-5xl text-beige-100 mb-2">
        Comment nous trouver
      </h2>
      <p class="text-center text-beige-300 mb-10 text-lg">{address} — Vallauris, Alpes-Maritimes</p>

      <div class="card-arabesque overflow-hidden shadow-xl">
        <div class="relative w-full" style="padding-top: 56.25%;">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d964.5462971933575!2d7.052169180304047!3d43.577944259776814!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12cc2b0068603e25%3A0xd4b3d65c3a4e6077!2sSalle%20de%20pri%C3%A8re%20Mosque%20de%20Vallauris!5e0!3m2!1sfr!2sfr!4v1777399106598!5m2!1sfr!2sfr"
            class="absolute inset-0 w-full h-full border-0"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Localisation de la Mosquée de Vallauris — 11bis Bd des Deux Vallons"
          ></iframe>
        </div>
      </div>

      <div class="mt-6 text-center">
        <a href={googleMapsUrl} target="_blank" rel="noopener"
           class="btn-outline text-beige-200 border-beige-400 inline-flex items-center gap-2">
          <Icon name="ph:navigation-arrow" class="w-4 h-4" />
          Itinéraire via Google Maps
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════ -->
  <section id="faq" class="py-20 bg-pattern-beige">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="heading-ornament text-4xl sm:text-5xl text-green-800 mb-2">
        Questions fréquentes
      </h2>
      <p class="text-center font-amiri text-2xl text-green-700/60 mb-12" lang="ar">الأسئلة الشائعة</p>

      <div class="space-y-3">
        {faqItems.map(({ q, a }) => (
          <details class="group card-arabesque bg-white border border-green-100 overflow-hidden">
            <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer list-none
                            font-semibold text-green-800 hover:text-gold transition-colors">
              {q}
              <Icon name="ph:plus" class="w-5 h-5 text-gold shrink-0 transition-transform duration-200 group-open:rotate-45" />
            </summary>
            <div class="px-5 pb-5 pt-3 text-green-700 leading-relaxed border-t border-green-50">
              {a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       FAIRE UN DON
  ══════════════════════════════════════════ -->
  <section id="don" class="py-24 bg-pattern-dark relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>

    <div class="max-w-3xl mx-auto px-4 text-center">
      <div class="flex justify-center mb-6">
        <Icon name="ph:hand-heart-fill" class="w-20 h-20 text-gold opacity-90" />
      </div>

      <h2 class="heading-ornament text-4xl sm:text-5xl text-beige-100 mb-6">
        Soutenez notre Mosquée
      </h2>

      <div class="divider-gold max-w-sm mx-auto mb-8">
        <span class="text-gold text-sm font-semibold tracking-widest uppercase">
          Votre don fait la différence
        </span>
      </div>

      <p class="text-beige-300 text-lg sm:text-xl leading-relaxed mb-4">
        La mosquée vit grâce à la générosité de sa communauté. Vos dons permettent
        d'assurer l'entretien du lieu de culte, l'organisation des activités
        religieuses et le soutien aux familles dans le besoin.
      </p>
      <p class="text-beige-400 text-base mb-10">
        Chaque contribution, petite ou grande, est une <em class="text-gold not-italic">sadaqa jâriya</em> —
        une aumône dont la récompense se perpétue.
      </p>

      <a href={helloAssoUrl} target="_blank" rel="noopener" class="btn-gold text-xl px-10 py-5">
        <Icon name="ph:heart-fill" class="w-6 h-6" />
        Faire un don sur HelloAsso
      </a>

      <p class="mt-6 text-beige-500 text-sm">
        Dons sécurisés via HelloAsso · Association culturelle de Vallauris
      </p>

      <div class="mt-12 font-amiri text-2xl text-gold/60 tracking-widest" lang="ar" dir="rtl">
        ﴿ وَمَا أَنفَقْتُم مِّن شَيْءٍ فَهُوَ يُخْلِفُهُ ﴾
      </div>
      <p class="text-beige-500 text-xs mt-1">
        « Tout ce que vous dépensez, Il vous le remplace. » — Sourate Saba', 39
      </p>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent"></div>
  </section>

  <!-- ══════════════════════════════════════════
       FOOTER
  ══════════════════════════════════════════ -->
  <footer class="bg-green-950 text-beige-400 py-12">
    <div class="max-w-5xl mx-auto px-4">
      <div class="grid sm:grid-cols-3 gap-8 mb-8">
        <!-- Identity -->
        <div>
          <h3 class="font-amiri text-xl text-beige-200 mb-3">La grande Mosquée de Vallauris</h3>
          <p class="text-sm leading-relaxed">{address}</p>
          <p class="text-xs text-beige-500 mt-1">Vallauris, Alpes-Maritimes (06220)</p>
          <a href={googleMapsUrl} target="_blank" rel="noopener"
             class="inline-flex items-center gap-1.5 text-gold text-sm hover:text-gold-light transition-colors mt-2">
            Voir sur la carte
            <Icon name="ph:arrow-square-out" class="w-3.5 h-3.5" />
          </a>
        </div>

        <!-- Liens rapides -->
        <div>
          <h3 class="font-amiri text-xl text-beige-200 mb-3">Liens rapides</h3>
          <ul class="space-y-2 text-sm">
            <li>
              <a href="#apropos" class="inline-flex items-center gap-2 hover:text-gold transition-colors">
                <Icon name="ph:info" class="w-4 h-4" />
                À propos
              </a>
            </li>
            <li>
              <a href="#prieres" class="inline-flex items-center gap-2 hover:text-gold transition-colors">
                <Icon name="ph:mosque" class="w-4 h-4" />
                Horaires des prières
              </a>
            </li>
            <li>
              <a href="#localisation" class="inline-flex items-center gap-2 hover:text-gold transition-colors">
                <Icon name="ph:map-pin" class="w-4 h-4" />
                Localisation
              </a>
            </li>
            <li>
              <a href="#faq" class="inline-flex items-center gap-2 hover:text-gold transition-colors">
                <Icon name="ph:question" class="w-4 h-4" />
                FAQ
              </a>
            </li>
            <li>
              <a href="#don" class="inline-flex items-center gap-2 hover:text-gold transition-colors">
                <Icon name="ph:hand-heart" class="w-4 h-4" />
                Faire un don
              </a>
            </li>
          </ul>
        </div>

        <!-- Ressources -->
        <div>
          <h3 class="font-amiri text-xl text-beige-200 mb-3">Ressources</h3>
          <ul class="space-y-2 text-sm">
            <li>
              <a href={mawaqitUrl} target="_blank" rel="noopener"
                 class="inline-flex items-center gap-2 hover:text-gold transition-colors">
                <Icon name="ph:clock" class="w-4 h-4" />
                Mawaqit — horaires de prières
                <Icon name="ph:arrow-square-out" class="w-3 h-3 opacity-60" />
              </a>
            </li>
            <li>
              <a href={helloAssoUrl} target="_blank" rel="noopener"
                 class="inline-flex items-center gap-2 hover:text-gold transition-colors">
                <Icon name="ph:heart" class="w-4 h-4" />
                HelloAsso — dons
                <Icon name="ph:arrow-square-out" class="w-3 h-3 opacity-60" />
              </a>
            </li>
          </ul>
          <div class="mt-6 font-amiri text-xl text-gold/40" lang="ar">
            مسجد فالوريس           
          </div>
        </div>
      </div>

      <div class="border-t border-green-800 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-beige-600">
        <p>© {new Date().getFullYear()} Association culturelle de Vallauris · Tous droits réservés</p>
        <p class="font-amiri text-base text-gold/60 tracking-widest" lang="ar">الله أكبر</p>
      </div>
    </div>
  </footer>

  <style>
    .bg-radial-glow {
      background: radial-gradient(ellipse at 50% 60%, rgba(201,168,76,0.07) 0%, transparent 70%);
    }
  </style>

  <script>
    const nav = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      nav?.classList.toggle('py-1', window.scrollY > 80);
    }, { passive: true });
  </script>
</Layout>
