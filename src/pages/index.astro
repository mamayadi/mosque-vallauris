---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import logoSvg from "../assets/logo.svg?raw";
import mosqueSvg from "../assets/mosque-illustration.svg?raw";

const mawaqitUrl =
  "https://mawaqit.net/fr/m/mosquee-de-vallauris-vallauris-06220-france";
const helloAssoUrl =
  "https://www.helloasso.com/associations/association-culturelle-de-vallauris/formulaires/1";
const googleMapsUrl = "https://maps.app.goo.gl/iCYVHbP1aZfZmQH88";
const address = "11bis Bd des Deux Vallons, 06220 Vallauris";
const campaignEmail = "vallauris.acv@gmail.com";

const campaign = {
  achatRdC: 300_000,
  travaux: 150_000,
  objectif: 450_000,
  collecte: 85_000,
  get reste() {
    return this.objectif - this.collecte;
  },
  get pct() {
    return Math.round((this.collecte / this.objectif) * 100);
  },
};

const fmt = (n: number) => n.toLocaleString("fr-FR");

const services = [
  { label: "Espace pour femmes", available: true, icon: "ph:gender-female" },
  { label: "Salle d'ablutions", available: true, icon: "ph:drop" },
  { label: "Cours pour adultes", available: true, icon: "ph:books" },
  { label: "Cours pour enfants", available: true, icon: "ph:graduation-cap" },
  { label: "Accès handicapés", available: false, icon: "ph:wheelchair" },
  { label: "Salât al-Janaza", available: false, icon: "ph:mosque" },
  { label: "Salat Al-Aïd", available: true, icon: "ph:moon-stars" },
  { label: "Iftar Ramadan", available: true, icon: "ph:moon-stars" },
  { label: "Parking", available: false, icon: "ph:car" },
];

const faqItems = [
  {
    q: "Où se trouve la Grande Mosquée de Vallauris ?",
    a: "La Grande Mosquée de Vallauris est située au 11bis Boulevard des Deux Vallons, 06220 Vallauris, Alpes-Maritimes. Elle est accessible depuis Golfe-Juan, Antibes et Cannes.",
  },
  {
    q: "Quels sont les horaires de prière à la mosquée de Vallauris ?",
    a: "Les horaires des cinq prières quotidiennes — Fajr (الفجر), Dhuhr (الظهر), Asr (العصر), Maghrib (المغرب) et Isha (العشاء) — varient chaque jour. Consultez Mawaqit pour les horaires en temps réel.",
  },
  {
    q: "Y a-t-il une prière du vendredi (Jumu'ah) à Vallauris ?",
    a: "Oui, la prière du vendredi (صلاة الجمعة) est célébrée chaque semaine à la mosquée de Vallauris. L'heure exacte varie selon la saison et est disponible sur Mawaqit.",
  },
  {
    q: "La mosquée dispose-t-elle d'un espace pour les femmes ?",
    a: "Oui, la mosquée de Vallauris dispose d'un espace dédié aux femmes pour la prière.",
  },
  {
    q: "Y a-t-il des cours d'arabe ou de Coran à Vallauris ?",
    a: "Oui, la mosquée propose des cours d'arabe et d'éducation islamique pour les enfants et les adultes. Contactez l'association pour les détails et les inscriptions.",
  },
  {
    q: "Comment soutenir financièrement la mosquée de Vallauris ?",
    a: "Vous pouvez faire un don en ligne via HelloAsso, la plateforme sécurisée de l'Association Culturelle de Vallauris. Chaque contribution aide à l'entretien du lieu et aux activités communautaires.",
  },
  {
    q: "La mosquée est-elle ouverte pendant le Ramadan ?",
    a: "Oui, la mosquée est particulièrement active pendant le mois de Ramadan : iftars communautaires, prières de Tarawih et prière de l'Aïd al-Fitr sont organisés chaque année.",
  },
  {
    q: "Comment rejoindre l'association ou obtenir plus d'informations ?",
    a: "Vous pouvez contacter l'Association Culturelle de Vallauris directement ou via HelloAsso. Retrouvez aussi les horaires en temps réel sur Mawaqit.",
  },
];

const siteUrl = "https://mosquee-vallauris.fr";

const additionalSchemas = {
  "@context": "https://schema.org",
  "@graph": [
    // ── FAQPage ──────────────────────────────────────────────────────────
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      mainEntity: faqItems.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
    // ── WebPage + sections ────────────────────────────────────────────────
    {
      "@type": "WebPage",
      "@id": `${siteUrl}/#webpage`,
      url: siteUrl,
      name: "Grande Mosquée de Vallauris",
      potentialAction: {
        "@type": "DonateAction",
        name: "Faire un don pour la mosquée de Vallauris",
        url: helloAssoUrl,
        description: `Campagne de collecte — objectif ${fmt(campaign.objectif)} €, ${fmt(campaign.collecte)} € réunis (${campaign.pct}%).`,
      },
      hasPart: [
        {
          "@type": "WebPageElement",
          name: "Campagne de collecte de dons — Achat de la mosquée",
          url: `${siteUrl}/#collecte`,
          description: `Campagne pour réunir ${fmt(campaign.objectif)} € : achat du rez-de-chaussée (${fmt(campaign.achatRdC)} €) et travaux d'aménagement (${fmt(campaign.travaux)} €). ${fmt(campaign.collecte)} € déjà collectés.`,
        },
        {
          "@type": "WebPageElement",
          name: "Notre histoire — Mosquée de Vallauris",
          url: `${siteUrl}/#histoire`,
          description:
            "Histoire de la mosquée de Vallauris depuis ses débuts au début des années 2000 jusqu'au projet d'achat du local.",
        },
        {
          "@type": "WebPageElement",
          name: "Horaires des prières — Fajr, Dhuhr, Asr, Maghrib, Isha",
          url: `${siteUrl}/#prieres`,
          description:
            "Horaires des cinq prières quotidiennes (الفجر، الظهر، العصر، المغرب، العشاء) à la mosquée de Vallauris, en temps réel via Mawaqit.",
        },
        {
          "@type": "WebPageElement",
          name: "Localisation — Comment nous trouver",
          url: `${siteUrl}/#localisation`,
          description: `${address} — Vallauris, Alpes-Maritimes (06220). Vue satellite.`,
        },
        {
          "@type": "WebPageElement",
          name: "Questions fréquentes — Mosquée de Vallauris",
          url: `${siteUrl}/#faq`,
          description:
            "Réponses aux questions fréquentes : horaires, adresse, espace femmes, cours, dons, Ramadan.",
        },
      ],
    },
  ],
};
---

<Layout
  title="Grande Mosquée de Vallauris — Aidez-nous à bâtir notre mosquée | 06220"
  description="Soutenez la Grande Mosquée de Vallauris (06220) — campagne de collecte pour l'achat du local. Horaires de prières, cours d'arabe, espace femmes. Association Culturelle de Vallauris."
  additionalSchema={additionalSchemas}
>
  <!-- ══════════════════════════════════════════
       NAVIGATION
  ══════════════════════════════════════════ -->
  <nav
    id="navbar"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300
              bg-green-800/95 backdrop-blur-sm shadow-lg"
  >
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <!-- Logo -->
      <a
        href="#accueil"
        class="flex items-center gap-2 text-beige-100 hover:text-gold transition-colors"
      >
        <Fragment set:html={logoSvg} />
        <span
          class="font-amiri text-sm font-bold hidden sm:inline leading-tight"
        >
          Grande Mosquée<br /><span class="text-gold">de Vallauris</span>
        </span>
      </a>

      <!-- Links -->
      <ul
        class="flex items-center gap-1 sm:gap-3 text-beige-200 text-sm font-semibold"
      >
        <li>
          <a
            href="#histoire"
            class="flex items-center gap-1.5 px-2 sm:px-3 py-2 rounded-lg hover:bg-white/10 hover:text-gold transition-all"
          >
            <Icon name="ph:book-open" class="w-4 h-4" />
            <span class="hidden sm:inline">Histoire</span>
          </a>
        </li>
        <li>
          <a
            href="#prieres"
            class="flex items-center gap-1.5 px-2 sm:px-3 py-2 rounded-lg hover:bg-white/10 hover:text-gold transition-all"
          >
            <Icon name="ph:mosque" class="w-4 h-4" />
            <span class="hidden sm:inline">Prières</span>
          </a>
        </li>
        <li>
          <a
            href="#localisation"
            class="flex items-center gap-1.5 px-2 sm:px-3 py-2 rounded-lg hover:bg-white/10 hover:text-gold transition-all"
          >
            <Icon name="ph:map-pin" class="w-4 h-4" />
            <span class="hidden sm:inline">Plan</span>
          </a>
        </li>
        <li>
          <a
            href={helloAssoUrl}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-1.5 px-3 py-2 rounded-full bg-gold text-green-800 hover:bg-gold-light transition-all font-bold"
          >
            <Icon name="ph:hand-heart" class="w-4 h-4" />
            Don
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- ══════════════════════════════════════════
       HERO
  ══════════════════════════════════════════ -->
  <section
    id="accueil"
    class="relative min-h-screen flex flex-col items-center justify-center text-center
                  bg-pattern-dark overflow-hidden pt-16"
  >
    <div class="absolute inset-0 bg-radial-glow pointer-events-none"></div>
    <div
      class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-gold to-transparent"
    >
    </div>

    <!-- Mosque SVG illustration -->
    <div
      class="relative z-10 w-full max-w-lg mx-auto px-4 mb-6 text-beige-100 opacity-90"
    >
      <Fragment set:html={mosqueSvg} />
    </div>

    <!-- Title -->
    <div class="relative z-10 px-4 animate-fade-in">
      <div class="divider-gold max-w-xs mx-auto mb-4">
        <span class="text-gold text-xl">بسم الله الرحمن الرحيم</span>
      </div>
      <h1
        class="font-amiri text-4xl sm:text-5xl md:text-6xl font-bold text-beige-100 leading-tight"
      >
        La grande Mosquée<br />
        <span class="text-gold">de Vallauris</span>
      </h1>
      <div class="mt-2 max-w-lg mx-auto">
        <p class="mt-2 font-amiri text-2xl sm:text-3xl font-bold text-gold">
          Un projet pour aujourd'hui, une sadaqa pour l'éternité
        </p>
        <blockquote class="mt-4 max-w-xl mx-auto space-y-1">
          <!-- <p class="font-amiri text-xl sm:text-2xl text-beige-200 leading-relaxed" lang="ar" dir="rtl">
                  «مَنْ بَنَى مَسْجِدًا لِلَّهِ، بَنَى اللَّهُ لَهُ بَيْتًا فِي الْجَنَّةِ» 
        </p> -->
          <p class="text-beige-400 text-sm sm:text-base italic">
            « Celui qui construit une mosquée pour Allah, Allah lui construit
            une demeure au Paradis. »
          </p>
          <!-- <footer class="text-beige-500 text-xs not-italic">
          Hadith — Sahih Muslim, rapporté sur l'autorité du Prophète ﷺ
        </footer> -->
        </blockquote>
      </div>
      <div
        class="mt-4 flex flex-col sm:flex-row items-center justify-center gap-4"
      >
        <a href={helloAssoUrl} target="_blank" rel="noopener" class="btn-gold">
          <Icon name="ph:heart-fill" class="w-5 h-5" />
          Faire un don
        </a>
        <a href="#collecte" class="btn-outline">
          <Icon name="ph:chart-bar" class="w-5 h-5" />
          Notre projet
        </a>
      </div>
    </div>

    <div
      class="absolute bottom-8 left-1/2 -translate-x-1/2 text-gold/60 animate-bounce z-10"
    >
      <Icon name="ph:caret-circle-down" class="w-8 h-8" />
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       COLLECTE + DON (merged)
  ══════════════════════════════════════════ -->
  <section id="collecte" class="py-20 bg-pattern-beige">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="heading-ornament text-4xl sm:text-5xl text-green-800 mb-2">
        Aidez-nous à bâtir notre mosquée
      </h2>
      <p class="text-center text-green-600 text-lg mb-10">
        Association Culturelle de Vallauris
      </p>

      <!-- Context -->
      <div class="space-y-4 text-green-800 leading-relaxed mb-10">
        <p>
          Depuis plusieurs années, la communauté musulmane de Vallauris prie
          dans un local en demi-sous-sol, exigu et inadapté, qui ne peut plus
          accueillir dignement le nombre croissant de fidèles venus chaque jour
          accomplir leur prière.
        </p>
        <p>
          Grâce à votre générosité et à la grâce d'Allah, nous avons déjà
          franchi une première étape décisive : l'acquisition du premier étage
          du bâtiment.
          <strong class="text-gold"> Alhamdulillah.</strong>
        </p>
        <p>
          Il nous reste aujourd'hui à accomplir la seconde et dernière étape :
          acheter le rez-de-chaussée et réaliser les travaux d'aménagement pour
          offrir à notre communauté un espace complet, accessible et digne.
        </p>
      </div>

      <!-- Un lieu pour… -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10">
        {
          [
            { icon: "ph:mosque", text: "Un lieu pour prier" },
            { icon: "ph:users-three", text: "Un lieu pour se retrouver" },
            { icon: "ph:graduation-cap", text: "Un lieu pour apprendre" },
            { icon: "ph:house-line", text: "Un lieu qui nous appartient" },
          ].map(({ icon, text }) => (
            <div class="flex flex-col items-center gap-2 text-center p-4 rounded-xl bg-green-800 text-beige-100">
              <Icon name={icon} class="w-7 h-7 text-gold" />
              <p class="font-amiri text-sm sm:text-base leading-tight">
                {text}
              </p>
            </div>
          ))
        }
      </div>

      <!-- Hadith -->
      <blockquote
        class="card-arabesque border-l-4 border-gold bg-white p-6 mb-10"
      >
        <p
          class="font-amiri text-2xl text-green-700 mb-3 text-right leading-relaxed"
          lang="ar"
          dir="rtl"
        >
          «مَنْ بَنَى مَسْجِدًا لِلَّهِ، بَنَى اللَّهُ لَهُ بَيْتًا فِي
          الْجَنَّةِ»
        </p>
        <p class="text-green-800 text-lg leading-relaxed italic">
          « Celui qui construit une mosquée pour Allah, Allah lui construit une
          demeure au Paradis. »
        </p>
        <footer class="text-green-600 text-sm mt-2 not-italic">
          Hadith — Sahih Muslim, rapporté sur l'autorité du Prophète ﷺ
        </footer>
      </blockquote>

      <!-- Sadaqa jariya -->
      <p class="text-center text-green-700 leading-relaxed mb-10">
        C'est une <em class="text-gold font-semibold not-italic"
          >sadaqa jaria</em
        > — une aumône dont la récompense continue après notre départ de ce monde.
        Chaque euro versé est une pierre posée pour vous, pour vos enfants et pour
        les générations futures.
      </p>

      <!-- Progress card -->
      <div
        class="card-arabesque bg-white border border-green-100 shadow-lg p-6 sm:p-8 mb-8"
      >
        <h3
          class="font-amiri text-2xl text-green-800 mb-6 flex items-center gap-2"
        >
          <Icon name="ph:chart-bar" class="w-6 h-6 text-gold" />
          État de la collecte
        </h3>

        <div class="mb-8">
          <div class="flex justify-between items-end mb-2">
            <span class="text-green-700 text-sm">
              Collecté : <strong class="text-green-800"
                >{fmt(campaign.collecte)} €</strong
              >
            </span>
            <span class="text-2xl font-bold text-gold">{campaign.pct}%</span>
          </div>
          <div class="w-full h-5 bg-green-100 rounded-full overflow-hidden">
            <div
              class="h-full bg-gold rounded-full progress-bar"
              style={`--progress-w: ${campaign.pct}%`}
            ></div>
          </div>
          <div class="flex justify-between text-xs text-green-500 mt-1">
            <span>0 €</span>
            <span>Objectif : {fmt(campaign.objectif)} €</span>
          </div>
        </div>

        <div class="space-y-1 text-sm sm:text-base">
          <div
            class="flex justify-between items-center py-3 border-b border-green-50"
          >
            <span class="text-green-700">Prix d'achat du rez-de-chaussée</span>
            <span class="font-semibold text-green-800"
              >{fmt(campaign.achatRdC)} €</span
            >
          </div>
          <div
            class="flex justify-between items-center py-3 border-b border-green-100"
          >
            <span class="text-green-700">Travaux et dépenses connexes</span>
            <span class="font-semibold text-green-800"
              >{fmt(campaign.travaux)} €</span
            >
          </div>
          <div
            class="flex justify-between items-center py-3 border-b border-green-200 bg-green-50 px-3 rounded"
          >
            <span class="font-bold text-green-800">Objectif total</span>
            <span class="font-bold text-green-800 text-lg"
              >{fmt(campaign.objectif)} €</span
            >
          </div>
          <div
            class="flex justify-between items-center py-3 border-b border-green-50"
          >
            <span class="text-green-700">
              Déjà collecté
              <span class="text-xs text-green-500 ml-1">Alhamdulillah</span>
            </span>
            <span class="font-bold text-gold text-lg"
              >{fmt(campaign.collecte)} €</span
            >
          </div>
          <div
            class="flex justify-between items-center py-4 px-4 rounded-xl bg-green-800 text-beige-100 mt-2"
          >
            <span class="font-semibold text-base">Reste à collecter</span>
            <span class="font-bold text-xl text-gold"
              >{fmt(campaign.reste)} €</span
            >
          </div>
        </div>

        <p class="text-center text-sm text-green-600 mt-4 italic">
          Alhamdulillah, nous avons déjà acheté le 1er étage et réuni {
            campaign.pct
          }% de l'objectif grâce aux dons des fidèles.
        </p>
      </div>

      <!-- CTA + Quranic verse -->
      <div class="text-center space-y-5">
        <p class="text-green-700 leading-relaxed max-w-xl mx-auto">
          Chaque don compte. Chaque partage compte. Si vous ne pouvez pas
          donner, partagez cette campagne autour de vous — c'est aussi un acte
          de bien.
        </p>

        <a
          href={helloAssoUrl}
          target="_blank"
          rel="noopener"
          class="btn-gold text-xl px-10 py-5 inline-flex items-center gap-3"
        >
          <Icon name="ph:heart-fill" class="w-6 h-6" />
          Faire un don sur HelloAsso
        </a>

        <p class="text-green-600 text-sm">
          Contact :
          <a
            href={`mailto:${campaignEmail}`}
            class="text-gold hover:text-gold-light underline underline-offset-2 transition-colors"
          >
            {campaignEmail}
          </a>
        </p>

        <div class="pt-6 border-t border-green-200 mt-4">
          <p
            class="font-amiri text-2xl text-green-700/60 tracking-widest"
            lang="ar"
            dir="rtl"
          >
            ﴿ وَمَا أَنفَقْتُم مِّن شَيْءٍ فَهُوَ يُخْلِفُهُ ﴾
          </p>
          <p class="text-green-600 text-xs mt-1">
            « Tout ce que vous dépensez, Il vous le remplace. » — Sourate Saba',
            39
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════
       NOTRE HISTOIRE
  ══════════════════════════════════════════ -->
  <section id="histoire" class="py-20 bg-pattern-dark">
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="heading-ornament text-4xl sm:text-5xl text-beige-100 mb-2">
        Notre histoire
      </h2>
      <p class="text-center font-amiri text-xl text-gold/80 mb-12">
        par la grâce d'Allah — بإذن الله
      </p>

      <div class="space-y-5 text-beige-300 text-base leading-relaxed">
        <p>
          L'histoire de la mosquée de Vallauris commence au début des années
          2000, par une simple salle de prière, modeste et discrète. Il serait
          difficile de parler à l'époque d'une véritable mosquée : le lieu était
          petit, situé en entresol, avec des moyens très limités. Pourtant,
          malgré l'étroitesse de l'espace, les cœurs étaient grands et unis dans
          l'adoration d'Allah.
        </p>
        <p>
          Pendant de nombreuses années, cette salle de prière a accueilli les
          fidèles pour les prières quotidiennes, le vendredi et le mois de
          Ramadan. C'est là que se sont tissés les premiers liens fraternels,
          dans la patience, la persévérance et la sincérité.
        </p>
        <p>
          Avec le temps, par la permission d'Allah, la communauté musulmane de
          Vallauris s'est agrandie. Les besoins ont augmenté, et cette simple
          salle de prière a naturellement évolué pour devenir un lieu plus
          structuré, assumant peu à peu le rôle de mosquée, au service de la
          prière, de l'éducation et de l'entraide.
        </p>
      </div>

      <div class="my-10 flex items-center gap-4">
        <div class="flex-1 h-px bg-gold/20"></div>
        <span class="text-gold font-amiri text-2xl">❋</span>
        <div class="flex-1 h-px bg-gold/20"></div>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 mb-10">
        <div class="card-arabesque bg-green-800/40 border border-gold/20 p-6">
          <h3 class="font-amiri text-xl text-gold mb-3 flex items-center gap-2">
            <Icon name="ph:calendar-check" class="w-5 h-5" />
            Aujourd'hui
          </h3>
          <p class="text-beige-300 text-sm leading-relaxed">
            Une étape essentielle s'ouvre : <strong class="text-beige-200"
              >l'achat du local</strong
            >, afin d'assurer la stabilité et l'avenir de ce lieu de culte.
          </p>
          <a
            href={helloAssoUrl}
            target="_blank"
            rel="noopener"
            class="mt-4 inline-flex items-center gap-2 text-gold hover:text-gold-light text-sm font-semibold transition-colors"
          >
            <Icon name="ph:hand-heart" class="w-4 h-4" />
            Soutenir ce projet
          </a>
        </div>
        <div class="card-arabesque bg-green-800/40 border border-gold/20 p-6">
          <h3 class="font-amiri text-xl text-gold mb-3 flex items-center gap-2">
            <Icon name="ph:star-four" class="w-5 h-5" />
            Demain
          </h3>
          <p class="text-beige-300 text-sm leading-relaxed">
            Notre espoir est de bâtir un espace <strong class="text-beige-200"
              >digne, accueillant et durable</strong
